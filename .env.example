# EduZim — Environment Variables (reference)
# ============================================================
# Regenerated Phase 20d via grep of `os.environ`/`os.getenv` across
# services + shared + scripts. Every variable code actually reads is
# documented here. Variables marked REQUIRED will crash the app on
# startup if unset.
#
# For LOCAL DEVELOPMENT:
#   Run `./scripts/bootstrap-secrets.sh` once. It generates a .env file
#   with strong random values for JWT_SECRET_KEY, INTERNAL_SERVICE_TOKEN,
#   and DB_PASSWORD. .env is gitignored.
#
# For PRODUCTION:
#   See docs/runbooks/secrets-rotation.md. Production secrets MUST come
#   from AWS Secrets Manager / HashiCorp Vault / your platform's secret
#   store — NEVER a committed .env or these CHANGE_ME placeholders.
#
# docker-compose.yml uses ${VAR:?...} interpolation for the REQUIRED
# group, so `docker compose up` fails fast if any are unset.


# ════════════════════════════════════════════════════════════════════
# REQUIRED — app won't start without these
# ════════════════════════════════════════════════════════════════════

# ─── JWT signing (BUG-003) ───
# Local dev: ./scripts/bootstrap-secrets.sh generates this.
# Manual:    openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ALGORITHM=HS256

# ─── Internal service token (BUG-004) ───
# Local dev: ./scripts/bootstrap-secrets.sh generates this.
# Manual:    openssl rand -hex 32
# This is what the gateway passes downstream as `X-Gateway-Token`.
# Services 401 any request without a matching value.
INTERNAL_SERVICE_TOKEN=CHANGE_ME_RANDOM_STRING


# ════════════════════════════════════════════════════════════════════
# Database (used by alembic + every service's app.config)
# ════════════════════════════════════════════════════════════════════

DB_USER=eduzim
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_HOST=postgres
DB_PORT=5432
# Per-service DATABASE_URL is composed by config from DB_* above.
# Override individually if a service points at a different DB.
# Defaults (post-PH2 consolidation):
#   academics    → academics_db
#   identity     → auth_db (kept for migration compat)
#   finance      → fees_db
#   communications → comms_db
#   reporting    → reporting_db
# DATABASE_URL=postgresql+psycopg2://eduzim:secret@postgres:5432/academics_db
# AUTH_DATABASE_URL=postgresql+psycopg2://eduzim:secret@postgres:5432/auth_db
# COMMS_DATABASE_URL=postgresql+psycopg2://eduzim:secret@postgres:5432/comms_db
# REPORTING_DATABASE_URL=postgresql+psycopg2://eduzim:secret@postgres:5432/reporting_db


# ════════════════════════════════════════════════════════════════════
# Gateway service routing (FQDNs the gateway proxies to)
# ════════════════════════════════════════════════════════════════════

ACADEMICS_SERVICE_URL=http://academics:8000
IDENTITY_SERVICE_URL=http://identity:8000
FINANCE_SERVICE_URL=http://finance:8000
COMMUNICATIONS_SERVICE_URL=http://communications:8000


# ════════════════════════════════════════════════════════════════════
# Infrastructure
# ════════════════════════════════════════════════════════════════════

# ─── Redis (gateway rate limiter — BUG-006) ───
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_ENABLED=true

# ─── Kafka (event bus; reporting consumer reads off it) ───
# Set false in tests to keep services from trying to publish to a
# non-existent cluster. Phase 7 will lift this for staging.
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092


# ════════════════════════════════════════════════════════════════════
# CORS / URLs
# ════════════════════════════════════════════════════════════════════

CORS_ORIGINS=https://admin.eduzim.co.zw,https://teacher.eduzim.co.zw,https://parent.eduzim.co.zw
FRONTEND_URL=https://admin.eduzim.co.zw


# ════════════════════════════════════════════════════════════════════
# Email (SMTP) — used by identity for password-reset, invite dispatch
# ════════════════════════════════════════════════════════════════════

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eduzim.co.zw

# SendGrid alternative (Phase 12c notification provider).
SENDGRID_API_KEY=


# ════════════════════════════════════════════════════════════════════
# Payments — Paynow Zimbabwe (Phase 12b)
# ════════════════════════════════════════════════════════════════════

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://api.eduzim.co.zw/api/v1/fees/payments/webhook/paynow
PAYNOW_RETURN_URL=https://admin.eduzim.co.zw/fees/payment-complete


# ════════════════════════════════════════════════════════════════════
# SMS / WhatsApp / Push (Phase 12c notification providers)
# ════════════════════════════════════════════════════════════════════

# Africa's Talking (SMS — primary channel in Zimbabwe).
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER=EduZim

# WhatsApp Cloud API (Meta).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Firebase Cloud Messaging (Push). NOTE: the legacy FCM Server Key
# was sunset by Google mid-2024; new deployments should use FCM v1
# OAuth credentials instead. Phase 20+ will swap the provider.
FCM_SERVER_KEY=


# ════════════════════════════════════════════════════════════════════
# Attachments storage (Phase 11b T-008 / Phase 17a)
# ════════════════════════════════════════════════════════════════════

# `local` writes to a host-mounted volume. `s3` is a NotImplementedError
# stub today (Phase 20+ infra task).
EDUZIM_ATTACHMENT_BACKEND=local
EDUZIM_ATTACHMENT_LOCAL_ROOT=/var/lib/eduzim/attachments
# Required when EDUZIM_ATTACHMENT_BACKEND=s3 (currently a stub).
EDUZIM_ATTACHMENT_S3_BUCKET=
EDUZIM_ATTACHMENT_S3_REGION=

# Dev-only escape: short-circuits the academics→communications HTTP
# call that clones attachments during template instantiation. Returns
# 0 cloned with `error_kind=disabled_env` in the audit row (Phase 19b).
# Logged warn-once when first triggered per process.
# EDUZIM_DISABLE_CROSS_SERVICE_HTTP=0


# ════════════════════════════════════════════════════════════════════
# Tenancy + governance (Phase 8 + 14)
# ════════════════════════════════════════════════════════════════════

# JSON or comma-separated registry of school_ids that get a dedicated
# DB schema instead of shared multi-tenant rows (Phase 8 tier B).
# EDUZIM_TENANCY_DEDICATED_REGISTRY=

# Same shape for the "district" tier (Phase 8 tier A).
# EDUZIM_TENANCY_DISTRICT_REGISTRY=


# ════════════════════════════════════════════════════════════════════
# Observability (Phase 6 — scaffolded; staging gate pending)
# ════════════════════════════════════════════════════════════════════

# Sentry — DSN-empty means no error capture. send_default_pii is
# hardcoded false (ADR 007).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry traces.
EDUZIM_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# mTLS between services (Phase 5 staging gate).
EDUZIM_TLS_ENABLED=false


# ════════════════════════════════════════════════════════════════════
# Misc operational
# ════════════════════════════════════════════════════════════════════

ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_VERSION=1.0.0
PORT=8000

# Reporting consumer loop tuning.
BATCH_SIZE=100
POLL_INTERVAL=1.0
MAX_RETRIES=3


# ════════════════════════════════════════════════════════════════════
# Docker image registry (used by docker-compose tag interpolation)
# ════════════════════════════════════════════════════════════════════

IMAGE_REGISTRY=ghcr.io/phani3108
IMAGE_TAG=latest
GATEWAY_PORT=8000


# ════════════════════════════════════════════════════════════════════
# Frontend (apps/*-web) — `NEXT_PUBLIC_*` vars, baked at build time
# ════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_SENTRY_DSN=
