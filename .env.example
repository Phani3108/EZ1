# EduZim — Environment Variables
# Copy to .env and fill in secrets before deployment

# ─── Database ───
DB_USER=eduzim
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ─── JWT ───
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# ─── Internal Service Token ───
INTERNAL_SERVICE_TOKEN=CHANGE_ME_RANDOM_STRING

# ─── Redis ───
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── CORS (comma-separated origins) ───
CORS_ORIGINS=https://admin.eduzim.co.zw,https://teacher.eduzim.co.zw,https://parent.eduzim.co.zw

# ─── Frontend URL (for password reset links) ───
FRONTEND_URL=https://admin.eduzim.co.zw

# ─── SMTP (Email) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eduzim.co.zw

# ─── Paynow Zimbabwe (Payment Gateway) ───
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://api.eduzim.co.zw/api/v1/fees/payments/webhook/paynow
PAYNOW_RETURN_URL=https://admin.eduzim.co.zw/fees/payment-complete

# ─── Africa's Talking (SMS) ───
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER=EduZim

# ─── Firebase Cloud Messaging (Push) ───
FCM_SERVER_KEY=

# ─── Docker Image Registry ───
IMAGE_REGISTRY=ghcr.io/phani3108
IMAGE_TAG=latest
GATEWAY_PORT=8000
